# ==============================================================================
# SalticeAgent Environment Configuration Template
# Copy this file to `.env` and fill in your API credentials.
# ==============================================================================

# Primary LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Local LLM Fallback (Ollama / LM Studio / vLLM)
LOCAL_MODEL_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=qwen2.5-coder:7b

# Visual Studio & Image Generation Engines
# Cloudflare Workers AI (Sub-2.5s edge diffusion: Flux Schnell & SDXL)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Hugging Face (ZeroGPU multi-model spaces & model hub)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Research & Intelligence Matrix
TAVILY_API_KEY=your_tavily_api_key_here
JINA_API_KEY=your_jina_api_key_here

# Developer & Security Auditing
GITHUB_PAT=your_github_personal_access_token_here
SNYK_TOKEN=your_snyk_security_token_here
JULES_API_KEY=your_jules_api_key_here
